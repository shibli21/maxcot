{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "maxcot": ["../../packages/maxcot/src/index.ts"],
      "maxcot/*": ["../../packages/maxcot/src/*/index.ts"],
      "maxcot-3d": ["../../packages/maxcot-3d/src/index.ts"]
    }
  },
  "include": ["src"]
}
