{
  "name": "maxcot",
  "version": "0.1.0",
  "description": "A character animation engine drawn entirely in code: one rig, 26 skins, a film player and a bars-and-beats sequencer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skins": {
      "types": "./dist/skins/index.d.ts",
      "default": "./dist/skins/index.js"
    },
    "./film": {
      "types": "./dist/film/index.d.ts",
      "default": "./dist/film/index.js"
    },
    "./score": {
      "types": "./dist/score/index.d.ts",
      "default": "./dist/score/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibli21/maxcot.git",
    "directory": "packages/maxcot"
  },
  "keywords": [
    "animation",
    "character",
    "canvas",
    "procedural",
    "generative",
    "mascot",
    "rig"
  ],
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run",
    "prepublishOnly": "bun run test"
  },
  "types": "./dist/index.d.ts"
}
