{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "maxcot": ["../maxcot/src/index.ts"],
      "maxcot/*": ["../maxcot/src/*/index.ts"]
    }
  },
  "include": ["src", "test"]
}
